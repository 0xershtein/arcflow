{
	"name": "arcflow-monorepo",
	"private": true,
	"type": "module",
	"description": "Typed flow engine and n8n-style canvas for building automations in code, JSON, or by prompting an LLM.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0xershtein/arcflow.git"
	},
	"packageManager": "pnpm@8.5.1",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "pnpm --filter playground dev",
		"build": "pnpm --filter \"./packages/**\" build && pnpm --filter playground build",
		"test": "vitest run",
		"check": "pnpm -r check"
	},
	"devDependencies": {
		"typescript": "^6.0.3",
		"vitest": "^5.0.1"
	}
}
