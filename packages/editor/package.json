{
	"name": "@arcflow/editor",
	"version": "0.1.0",
	"description": "Embeddable n8n-style flow editor. Framework-free: mount it anywhere, feed it flow JSON, get flow JSON back.",
	"license": "MIT",
	"type": "module",
	"sideEffects": true,
	"exports": {
		".": {
			"types": "./dist/svelte/index.d.ts",
			"default": "./dist/index.js"
		},
		"./svelte": {
			"types": "./src/svelte.ts",
			"svelte": "./src/svelte.ts",
			"default": "./src/svelte.ts"
		},
		"./styles.css": "./src/styles.css",
		"./app": {
			"types": "./dist/svelte/app.d.ts",
			"default": "./dist/app.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/svelte/index.d.ts",
				"default": "./dist/index.js"
			},
			"./svelte": {
				"types": "./dist/svelte/svelte.d.ts",
				"svelte": "./dist/svelte/svelte.js",
				"default": "./dist/svelte/svelte.js"
			},
			"./styles.css": "./dist/svelte/styles.css",
			"./app": {
				"types": "./dist/svelte/app.d.ts",
				"default": "./dist/app.js"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "vite build && vite build -c vite.app.config.ts && svelte-package -i src -o dist/svelte",
		"check": "svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@arcflow/core": "workspace:*",
		"@xyflow/svelte": "^1.6.6"
	},
	"peerDependencies": {
		"svelte": "^5.57.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "5.57.0",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arcsig-labs/arcflow.git",
		"directory": "packages/editor"
	},
	"keywords": [
		"flow",
		"workflow",
		"editor",
		"canvas",
		"node-editor",
		"n8n",
		"automation",
		"no-code"
	]
}
