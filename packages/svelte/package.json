{
	"name": "@arcflow/svelte",
	"version": "0.1.0",
	"description": "n8n-style canvas editor for arcflow flows, built on Svelte Flow.",
	"license": "MIT",
	"type": "module",
	"svelte": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"svelte": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./theme.css": "./src/theme.css"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"svelte": "./dist/index.js",
				"default": "./dist/index.js"
			},
			"./theme.css": "./dist/theme.css"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "svelte-package -i src -o dist",
		"check": "svelte-check --tsconfig ./tsconfig.json"
	},
	"peerDependencies": {
		"svelte": "^5.57.0"
	},
	"dependencies": {
		"@arcflow/core": "workspace:*",
		"@xyflow/svelte": "^1.6.6"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0xershtein/arcflow.git",
		"directory": "packages/svelte"
	},
	"devDependencies": {
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"svelte": "5.57.0",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3"
	}
}
