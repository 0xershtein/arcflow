{
	"name": "@arcflow/nodes",
	"version": "0.1.0",
	"description": "Standard arcflow steps: manual, webhook and schedule triggers, HTTP requests, sandboxed JavaScript, data, branching, loops, waits and sub-flows.",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@arcflow/core": "workspace:*",
		"@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
		"croner": "^10.0.1",
		"quickjs-emscripten-core": "^0.32.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arcsig-labs/arcflow.git",
		"directory": "packages/nodes"
	},
	"keywords": [
		"workflow",
		"automation",
		"http",
		"webhook",
		"cron",
		"sandbox"
	]
}
